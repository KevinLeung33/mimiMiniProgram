page {
  background: #fff8ef;
  color: #3f3329;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 48rpx;
}

.card {
  background: #fffdf9;
  border-radius: 28rpx;
  box-sizing: border-box;
  padding: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(125, 92, 64, 0.08);
}

.section-title {
  color: #5c4635;
  font-size: 32rpx;
  font-weight: 700;
}

.section-hint {
  color: #9d8978;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.primary-button {
  align-items: center;
  background: #da7a4b;
  border-radius: 20rpx;
  color: #fffdf9;
  display: flex;
  font-size: 30rpx;
  font-weight: 700;
  height: 92rpx;
  justify-content: center;
  line-height: 92rpx;
}

.ghost-button {
  align-items: center;
  background: #f9eadb;
  border-radius: 18rpx;
  color: #a45e37;
  display: flex;
  font-size: 26rpx;
  height: 76rpx;
  justify-content: center;
  line-height: 76rpx;
}
