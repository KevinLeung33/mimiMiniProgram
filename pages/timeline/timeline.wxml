<view class="page">
  <view class="intro">
    <view class="eyebrow">真实记录与虚拟回忆分开保存</view>
    <view class="title">猫咪日记</view>
    <view class="description">以后这里可以增加照片、周报和湿粮偏好统计。</view>
  </view>

  <view wx:if="{{records.length}}" class="record-list">
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-date">{{item.dateLabel}}</view>
      <view class="record-stats">
        <text>💧 {{item.urineText}}</text>
        <text>💩 {{item.stoolText}}</text>
      </view>
      <view class="record-food">🥣 {{item.foodText}}</view>
      <view wx:if="{{item.foodDetail}}" class="record-food-detail">{{item.foodDetail}}</view>
      <view wx:if="{{item.note}}" class="record-note">“{{item.note}}”</view>
    </view>
  </view>
  <view wx:else class="empty-card">
    <view class="empty-icon">📖</view>
    <view class="empty-title">还没有真实日记</view>
    <view class="empty-text">去“记录”页留下第一条吧。</view>
  </view>

  <view wx:if="{{memories.length}}" class="memory-section">
    <view class="section-title">最近的小剧场回忆</view>
    <view class="section-hint">这些是虚拟互动，不会混进真实照护记录。</view>
    <view class="memory-item" wx:for="{{memories}}" wx:key="id">
      <view class="memory-time">{{item.date}} {{item.time}} · {{item.scene}}</view>
      <view class="memory-text">{{item.response}}</view>
    </view>
  </view>
</view>
